{
  "name": "study-space",
  "private": true,
  "version": "0.6.0",
  "description": "面向 Windows 和 Android 平板的本地优先学习管理应用",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengxin23333-hue/study-space.git"
  },
  "bugs": {
    "url": "https://github.com/chengxin23333-hue/study-space/issues"
  },
  "homepage": "https://github.com/chengxin23333-hue/study-space#readme",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc -b && vite build",
    "clean:check": "node scripts/clean-workspace.mjs",
    "clean:generated": "node scripts/clean-workspace.mjs --apply",
    "test": "vitest",
    "test:clean": "node --test scripts/clean-workspace.node-test.mjs",
    "test:run": "vitest run",
    "check": "npm run test:run && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "2.7.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "lucide-react": "^1.48.0",
    "lunar-typescript": "1.8.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
